# ============================================================================
#  Variáveis de ambiente do backend (assistente de IA + captura de leads)
# ----------------------------------------------------------------------------
#  Local: copie para ".env"  (cp .env.example .env) e preencha.
#  Produção (Vercel): configure estas variáveis no painel do projeto.
# ============================================================================

# Chave da API do Gemini (obrigatória para o assistente).
# Gere em: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelo do Gemini (opcional). "gemini-flash-latest" = flash estável mais recente.
GEMINI_MODEL=gemini-flash-latest

# Para onde enviar os leads capturados (opcional, mas recomendado).
# Cole aqui a URL do seu Web App do Google Apps Script (planilha do Sheets).
# Se ficar vazio, o lead é apenas registrado no log do servidor.
LEAD_WEBHOOK_URL=

# Porta do servidor local de desenvolvimento (opcional).
PORT=3001
